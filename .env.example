# ================================================================
#  Mukti Portal — Frontend Environment Variables
#  Copy this file to .env and fill in your real values.
#
#  NEVER commit the actual .env file to version control.
#  This file (.env.example) is safe to commit — it has NO real values.
# ================================================================

# ----------------------------------------------------------------
#  Firebase Client SDK Configuration  (REQUIRED)
#  Get all values from Firebase Console:
#  https://console.firebase.google.com
#  → Project Settings → Your Apps → SDK setup & configuration
# ----------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_hash
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------
#  Backend API URL  (REQUIRED)
#  URL of the Node.js/Express backend server.
#  For local dev:       http://localhost:5000
#  For Railway/Render:  https://your-backend.up.railway.app
# ----------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:5000

# ----------------------------------------------------------------
#  ML Service URL  (OPTIONAL)
#  URL of the Python/Flask ML micro-service.
#  For local dev:       http://localhost:5001
#  For Railway/Render:  https://your-ml-service.up.railway.app
# ----------------------------------------------------------------

VITE_ML_SERVICE_URL=http://localhost:5001

# ----------------------------------------------------------------
#  Admin Identity  (REQUIRED for production admin access)
#  The Google account email that receives admin role.
#  NEVER hardcode this in source code.
# ----------------------------------------------------------------

VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_NAME="Admin User"
VITE_ADMIN_PASSWORD=adminpassword
VITE_ADMIN_PHONE=
