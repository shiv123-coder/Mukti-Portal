rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // 2. Verification Requests
    match /verification_requests/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.workerId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.workerId;
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // 3. Completed Verifications
    match /verifications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.workerId || request.auth.uid == resource.data.customerId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // 4. Work Requests/Job Feed
    match /work_requests/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.workerId || request.resource.data.workerId == request.auth.uid || isAdmin()); 
      allow delete: if request.auth != null && (request.auth.uid == resource.data.customerId || isAdmin());
    }

    // 5. Public Credit Report Snapshots (QR Code Verification)
    match /public_reports/{reportId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == reportId;
      allow delete: if false; 
    }
    // 6. User and Admin Notifications
    match /notifications/{docId} {
      allow read, update, delete: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null;
    }
  }
}
