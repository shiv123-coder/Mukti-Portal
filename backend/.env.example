# ================================================================
#  Mukti Portal — Backend (Node.js/Express) Environment Variables
#  Copy this file to .env and fill in your real values.
#
#  NEVER commit the actual .env file to version control.
#  This file (.env.example) is safe to commit — it has NO real values.
# ================================================================

# ----------------------------------------------------------------
#  Server Configuration  (REQUIRED)
# ----------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# ----------------------------------------------------------------
#  ML Service URL  (REQUIRED)
#  URL of the Python/Flask ML micro-service.
#  For local dev:       http://localhost:5001
#  For production:      https://your-ml-service.up.railway.app
# ----------------------------------------------------------------

ML_SERVICE_URL=http://localhost:5001

# ----------------------------------------------------------------
#  Firebase Admin SDK  (REQUIRED for production)
#  The backend uses the Admin SDK to bypass Firestore security rules.
#
#  Steps to generate the service account key:
#    1. Firebase Console → Project Settings → Service Accounts
#    2. Click "Generate new private key"
#    3. Save the JSON file to backend/secrets/  (gitignored)
#    4. Set the relative path below (relative to backend/ root)
# ----------------------------------------------------------------

FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account-key.json

# ----------------------------------------------------------------
#  CORS / Allowed Origins  (REQUIRED for production)
#  Comma-separated list of allowed frontend origins.
#  For local dev:       http://localhost:8080
#  For production:      https://your-app.vercel.app
# ----------------------------------------------------------------

CORS_ORIGIN=http://localhost:8080

# ----------------------------------------------------------------
#  Node Environment  (OPTIONAL)
#  Set to "production" in production deployments.
# ----------------------------------------------------------------

NODE_ENV=development
